<?php

/**
 * @file
 * Functions to support theming.
 */

/**
 * Implements hook_preprocess_node().
 *
 * Two bundle-specific things:
 *  - card_set:full — embeds the cards-in-set views block.
 *  - card:full     — computes prev/next siblings (cards in the same
 *    set ordered by collector_number) so the detail-page breadcrumb
 *    can paginate within the set.
 */
function inkfolk_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }

  if ($node->bundle() === 'card_set') {
    $variables['cards_in_set'] = views_embed_view('cards', 'block_set', $node->id());
    return;
  }

  if ($node->bundle() !== 'card' || $node->get('field_set')->isEmpty()) {
    return;
  }

  $set_id = $node->get('field_set')->target_id;
  $current_number = $node->get('field_collector_number')->value;
  $langcode = $node->language()->getId();
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  // Same-set siblings ordered alphanumerically by collector_number.
  // The field is a string ("1", "2", ..., "204a"), so we sort
  // lexicographically and pad-shorter-numbers via a single query.
  $sibling_ids = $node_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'card')
    ->condition('field_set', $set_id)
    ->condition('langcode', $langcode)
    ->sort('field_collector_number', 'ASC')
    ->execute();
  $sibling_ids = array_values($sibling_ids);
  $position = array_search($node->id(), $sibling_ids, TRUE);

  $variables['card_prev'] = NULL;
  $variables['card_next'] = NULL;
  if ($position !== FALSE) {
    if ($position > 0) {
      $variables['card_prev'] = $node_storage->load($sibling_ids[$position - 1]);
    }
    if ($position < count($sibling_ids) - 1) {
      $variables['card_next'] = $node_storage->load($sibling_ids[$position + 1]);
    }
  }
  $variables['card_position'] = $position + 1;
  $variables['card_set_total'] = count($sibling_ids);
}

/**
 * Implements hook_preprocess_facets_result_item().
 *
 * Computes a slug from the displayed facet value so the template
 * can render a colored swatch next to ink + rarity items.
 */
function inkfolk_preprocess_facets_result_item(array &$variables): void {
  $rendered = is_array($variables['value'])
    ? (string) \Drupal::service('renderer')->render($variables['value'])
    : (string) $variables['value'];
  $text = trim(str_replace('(-)', '', strip_tags($rendered)));
  $slug = strtolower(preg_replace('/[^a-z0-9]+/i', '-', $text));
  $slug = trim($slug, '-');
  $variables['value_slug'] = $slug;
}

/**
 * Implements hook_preprocess_image_widget().
 */
function inkfolk_preprocess_image_widget(array &$variables): void {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}
