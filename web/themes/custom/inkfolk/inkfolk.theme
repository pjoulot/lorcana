<?php

/**
 * @file
 * Functions to support theming.
 */

/**
 * Implements hook_preprocess_page().
 *
 * Mirrors the active encyclopedia query (?search=) back into the topnav
 * search field, so a submitted search stays visible and editable instead
 * of the box appearing to clear itself after results load.
 */
function inkfolk_preprocess_page(array &$variables): void {
  $search = \Drupal::request()->query->get('search');
  $variables['topnav_search'] = is_string($search) ? $search : '';
  // The topnav renders on every page, so vary it on the search param.
  $variables['#cache']['contexts'][] = 'url.query_args:search';

  // Language switcher in the topnav: the current language plus links to the
  // same page in each other language (URL-prefix negotiation).
  $language_manager = \Drupal::languageManager();
  $variables['language_switcher'] = [];
  if ($language_manager->isMultilingual()) {
    $current = $language_manager->getCurrentLanguage()->getId();
    $current_path = \Drupal::service('path.current')->getPath();
    $query = \Drupal::request()->query->all();
    foreach ($language_manager->getLanguages() as $langcode => $language) {
      $url = \Drupal\Core\Url::fromUserInput($current_path, [
        'language' => $language,
        'query' => $query,
      ]);
      $variables['language_switcher'][] = [
        'langcode' => $langcode,
        'label' => strtoupper($langcode),
        'name' => $language->getName(),
        'url' => $url->toString(),
        'active' => $langcode === $current,
      ];
    }
    $variables['#cache']['contexts'][] = 'url.path';
    $variables['#cache']['contexts'][] = 'languages:' . \Drupal\Core\Language\LanguageInterface::TYPE_URL;
  }
}

/**
 * Implements hook_preprocess_node().
 *
 * Two bundle-specific things:
 *  - card_set:full — embeds the cards-in-set views block.
 *  - card:full     — computes prev/next siblings (cards in the same
 *    set ordered by collector_number) so the detail-page breadcrumb
 *    can paginate within the set.
 */
function inkfolk_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node || ($variables['view_mode'] ?? '') !== 'full') {
    return;
  }

  if ($node->bundle() === 'card_set') {
    $set_id = $node->id();
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');

    // Counts shown in the hero band + chase-cards header.
    $variables['cards_total'] = (int) $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'card')
      ->condition('field_set', $set_id)
      ->count()
      ->execute();
    $variables['enchanted_count'] = (int) $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'card')
      ->condition('field_set', $set_id)
      ->condition('field_rarity', 'enchanted')
      ->count()
      ->execute();
    $variables['legendary_count'] = (int) $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'card')
      ->condition('field_set', $set_id)
      ->condition('field_rarity', 'legendary')
      ->count()
      ->execute();

    // Chase cards: up to 5, enchanted first (alphabetically before
    // 'legendary'), then legendary; deterministic via secondary sort
    // on collector_number. Skip cards without art so the section
    // never renders a half-painted card-back.
    $chase_ids = $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'card')
      ->condition('field_set', $set_id)
      ->condition('field_rarity', ['enchanted', 'legendary'], 'IN')
      ->exists('field_card_art')
      ->sort('field_rarity', 'ASC')
      ->sort('field_collector_number', 'ASC')
      ->range(0, 5)
      ->execute();
    $variables['chase_cards'] = [];
    if ($chase_ids) {
      $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
      foreach ($node_storage->loadMultiple($chase_ids) as $card_node) {
        $variables['chase_cards'][] = [
          'rarity' => $card_node->get('field_rarity')->value,
          'rarity_label' => ucwords(str_replace('_', ' ', $card_node->get('field_rarity')->value)),
          'render' => $view_builder->view($card_node, 'teaser'),
        ];
      }
    }

    return;
  }

  if ($node->bundle() === 'news') {
    // Related news: up to 3 other recently-published news articles,
    // excluding the current one. Prefer same-category matches; fall
    // back to most-recent overall if too few matches.
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    $category_id = $node->get('field_category')->target_id;

    $related_ids = [];
    if ($category_id) {
      $related_ids = $node_storage->getQuery()
        ->accessCheck(TRUE)
        ->condition('type', 'news')
        ->condition('status', 1)
        ->condition('field_category', $category_id)
        ->condition('nid', $node->id(), '<>')
        ->sort('field_published_at', 'DESC')
        ->range(0, 3)
        ->execute();
    }
    if (count($related_ids) < 3) {
      $extra_ids = $node_storage->getQuery()
        ->accessCheck(TRUE)
        ->condition('type', 'news')
        ->condition('status', 1)
        ->condition('nid', array_merge([$node->id()], array_values($related_ids)), 'NOT IN')
        ->sort('field_published_at', 'DESC')
        ->range(0, 3 - count($related_ids))
        ->execute();
      $related_ids = array_merge(array_values($related_ids), array_values($extra_ids));
    }

    $variables['related_news'] = [];
    foreach ($node_storage->loadMultiple($related_ids) as $related) {
      $body_value = $related->get('body')->value ?? '';
      $excerpt = $related->get('body')->summary ?: trim(strip_tags($body_value));
      if (mb_strlen($excerpt) > 160) {
        $excerpt = mb_substr($excerpt, 0, 160) . '…';
      }
      $cover_media = $related->get('field_cover')->entity;
      $cover_render = $cover_media
        ? \Drupal::entityTypeManager()->getViewBuilder('media')->view($cover_media, 'default')
        : NULL;
      $variables['related_news'][] = [
        'title' => $related->label(),
        'url' => $related->toUrl(),
        'author' => $related->get('field_author')->value,
        'published' => $related->get('field_published_at')->value,
        'category' => $related->get('field_category')->entity
          ? $related->get('field_category')->entity->label()
          : '',
        'excerpt' => $excerpt,
        'cover' => $cover_render,
      ];
    }
    return;
  }

  if ($node->bundle() !== 'card' || $node->get('field_set')->isEmpty()) {
    return;
  }

  $set_id = $node->get('field_set')->target_id;
  $langcode = $node->language()->getId();
  $node_storage = \Drupal::entityTypeManager()->getStorage('node');

  // Same-set siblings ordered alphanumerically by collector_number.
  // The field is a string ("1", "2", ..., "204a"), so we sort
  // lexicographically and pad-shorter-numbers via a single query.
  $sibling_ids = $node_storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'card')
    ->condition('field_set', $set_id)
    ->condition('langcode', $langcode)
    ->sort('field_collector_number', 'ASC')
    ->execute();
  $sibling_ids = array_values($sibling_ids);
  $position = array_search($node->id(), $sibling_ids, TRUE);

  $variables['card_prev'] = NULL;
  $variables['card_next'] = NULL;
  if ($position !== FALSE) {
    if ($position > 0) {
      $variables['card_prev'] = $node_storage->load($sibling_ids[$position - 1]);
    }
    if ($position < count($sibling_ids) - 1) {
      $variables['card_next'] = $node_storage->load($sibling_ids[$position + 1]);
    }
  }
  $variables['card_position'] = $position + 1;
  $variables['card_set_total'] = count($sibling_ids);

  // Other printings: the standard / Enchanted / promo variants that share
  // this card's printing group, in the same language (the current printing is
  // excluded — the section lists the *others*). See spec 02 printing variants.
  $variables['card_printings'] = [];
  $group_id = $node->get('field_printing_group_id')->value;
  if ($group_id) {
    $printing_ids = $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'card')
      ->condition('field_printing_group_id', $group_id)
      ->condition('langcode', $langcode)
      ->condition('nid', $node->id(), '<>')
      ->sort('field_collector_number', 'ASC')
      ->execute();
    foreach ($node_storage->loadMultiple($printing_ids) as $printing) {
      $rarity = $printing->get('field_rarity')->value;
      $ink = $printing->get('field_ink')->entity;
      $number = $printing->get('field_collector_number')->value;
      $variables['card_printings'][] = [
        'url' => $printing->toUrl()->toString(),
        'rarity' => $rarity ? ucfirst(str_replace('_', ' ', $rarity)) : '',
        'number' => $number ? '#' . $number : '',
        'ink_slug' => $ink ? strtolower($ink->label()) : '',
        'is_enchanted' => $rarity === 'enchanted',
        'image' => $printing->get('field_card_art')->view([
          'type' => 'media_thumbnail',
          'label' => 'hidden',
          'settings' => ['image_style' => 'medium', 'image_link' => ''],
        ]),
      ];
    }
  }
}

/**
 * Implements hook_preprocess_facets_result_item().
 *
 * Computes a slug from the displayed facet value so the template
 * can render a colored swatch next to ink + rarity items.
 */
function inkfolk_preprocess_facets_result_item(array &$variables): void {
  $rendered = is_array($variables['value'])
    ? (string) \Drupal::service('renderer')->render($variables['value'])
    : (string) $variables['value'];
  $text = trim(str_replace('(-)', '', strip_tags($rendered)));
  $slug = strtolower(preg_replace('/[^a-z0-9]+/i', '-', $text));
  $slug = trim($slug, '-');
  $variables['value_slug'] = $slug;
}

/**
 * Implements hook_preprocess_image_widget().
 */
function inkfolk_preprocess_image_widget(array &$variables): void {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}
