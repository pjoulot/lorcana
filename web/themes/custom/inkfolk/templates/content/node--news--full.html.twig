{#
/**
 * @file
 * News article — full view mode (canonical /news/<slug> page).
 *
 * Single-column editorial layout: optional cover image hero,
 * category eyebrow + big serif H1, author/date/read meta line,
 * then the body content. Card-reference token replacement
 * ([card:set/number] → linked chip with hover popover) is a
 * separate filter that lands as a follow-up commit.
 */
#}
{% set author = node.field_author.value %}
{% set published = node.field_published_at.0.value %}
{% set category_label = node.field_category.entity ? node.field_category.entity.label : '' %}

<article{{ attributes.addClass('if-news-article') }}>

  {% if node.field_cover.entity %}
    <div class="if-news-article__cover">
      {{ content.field_cover }}
    </div>
  {% endif %}

  <div class="if-news-article__inner">

    <header class="if-news-article__header">
      {% if category_label %}
        <div class="if-news-article__eyebrow">{{ category_label }}</div>
      {% endif %}
      <h1 class="if-news-article__title serif">{{ node.label }}</h1>
      <div class="if-news-article__meta">
        {% if author %}<span>{{ author }}</span>{% endif %}
        {% if author and published %}<span class="if-news-article__meta-sep">·</span>{% endif %}
        {% if published %}<span>{{ published|date('j F Y') }}</span>{% endif %}
      </div>
    </header>

    <div class="if-news-article__body">
      {{ content.body }}
    </div>

  </div>

  {% if related_news is defined and related_news|length > 0 %}
    <aside class="if-news-related">
      <div class="if-news-related__inner">
        <header class="if-news-related__header">
          <div class="if-home-section__eyebrow">{{ 'Keep reading'|t }}</div>
          <h2 class="if-home-section__title serif">{{ 'Related articles'|t }}</h2>
        </header>
        <div class="if-news-related__grid">
          {% for a in related_news %}
            <a class="if-news-card if-news-related__card" href="{{ a.url }}">
              <div class="if-news-card__cover">
                {% if a.cover %}
                  {{ a.cover }}
                {% else %}
                  <div class="if-news-card__cover-placeholder if-news-card__cover-placeholder--{{ loop.index0 % 6 }}" aria-hidden="true"></div>
                {% endif %}
                {% if a.category %}
                  <span class="if-news-card__cat">{{ a.category }}</span>
                {% endif %}
              </div>
              <div class="if-news-card__body">
                <div class="if-news-card__meta">
                  {% if a.author %}<span>{{ a.author }}</span>{% endif %}
                  {% if a.author and a.published %}<span class="if-news-card__meta-sep">·</span>{% endif %}
                  {% if a.published %}<span>{{ a.published|date('M j') }}</span>{% endif %}
                </div>
                <h3 class="if-news-card__title serif">{{ a.title }}</h3>
                {% if a.excerpt %}
                  <p class="if-news-card__excerpt">{{ a.excerpt }}</p>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>
      </div>
    </aside>
  {% endif %}

</article>
