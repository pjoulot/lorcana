{#
/**
 * @file
 * Card node — teaser view mode (encyclopedia grid + list cells).
 *
 * Renders a single Lorcana card as a clickable, aspect-locked tile
 * wrapping its licensed art. The frame treatment defaults to
 * "subtle" (per design); the encyclopedia or detail page can swap
 * the modifier when needed.
 *
 * The text payload (name, ink, type, stats, rarity) is rendered
 * but hidden in grid mode via CSS. When .view-cards switches into
 * list mode (data-view-mode="list" on the container), the same
 * teaser markup reflows to a horizontal row with the text visible.
 *
 * Available variables documented in core's node.html.twig.
 */
#}
{% set has_art = content.field_card_art|render is not empty %}
{% set classes = [
  'if-lcard',
  'if-cardframe--subtle',
  not has_art ? 'if-lcard--no-art',
] %}
{% set version = node.field_version.value %}
{% set version_suffix = version ? ' — ' ~ version : '' %}
{% set base_name = version ? node.label|replace({(version_suffix): ''}) : node.label %}
{% set rarity_raw = node.field_rarity.value %}
{% set rarity_letter = rarity_raw == 'common' ? 'C'
  : (rarity_raw == 'uncommon' ? 'U'
  : (rarity_raw == 'rare' ? 'R'
  : (rarity_raw == 'super_rare' ? 'SR'
  : (rarity_raw == 'legendary' ? 'L'
  : (rarity_raw == 'enchanted' ? 'E' : '')))))
%}
{% set is_character = false %}
{% for t in node.field_card_types %}{% if t.value == 'character' %}{% set is_character = true %}{% endif %}{% endfor %}

<a href="{{ url }}"
   {{ attributes.addClass(classes) }}
   aria-label="{{ node.label }}">
  <div class="if-card-image">
    {{ content.field_card_art }}
  </div>
  {# List-mode payload: hidden in grid via CSS. #}
  <div class="if-lcard__row" aria-hidden="true">
    <div class="if-lcard__row-text">
      <div class="if-lcard__row-name serif">{{ base_name }}</div>
      <div class="if-lcard__row-meta">
        {% if card_ink_chips %}
          <span class="if-lcard__row-ink">
            {% if card_ink_chips|length > 1 %}
              <span class="if-swatch if-swatch--split"
                    style="--ink-a: var(--ink-{{ card_ink_chips.0.slug }}); --ink-b: var(--ink-{{ card_ink_chips.1.slug }});"
                    aria-hidden="true"></span>
            {% else %}
              <span class="if-swatch if-swatch--{{ card_ink_chips.0.slug }}" aria-hidden="true"></span>
            {% endif %}
            {{ card_ink_chips|map(c => c.label)|join(' + ') }}
          </span>
          <span class="if-lcard__row-sep">·</span>
        {% endif %}
        {% if card_type_labels %}
          <span>{{ card_type_labels|join(' · ') }}</span>
        {% endif %}
        {% if is_character and node.field_strength.value is not empty %}
          <span class="if-lcard__row-sep">·</span>
          <span class="mono if-lcard__row-stats">{{ node.field_strength.value }}/{{ node.field_willpower.value }} · {{ node.field_lore.value }}◆</span>
        {% endif %}
      </div>
    </div>
    {% if rarity_letter %}
      <div class="if-lcard__row-rarity if-lcard__row-rarity--{{ rarity_raw|replace({'_': '-'}) }}">{{ rarity_letter }}</div>
    {% endif %}
  </div>
</a>
