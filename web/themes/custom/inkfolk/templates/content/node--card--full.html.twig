{#
/**
 * @file
 * Card node — full view mode (canonical /cards/{set}/{number} page).
 *
 * Port of card-detail.jsx (specs/design/.../project/src/). Bones-
 * version of the design — items wired through the data we have:
 *  - breadcrumb + prev/next (siblings by collector_number)
 *  - chips strip (ink/type/rarity/classifications)
 *  - title H1 + italic subtitle
 *  - icon stats strip (inline SVG icons)
 *  - rules text + flavor in a serif surface box
 *  - 2-col "Printing details" + "Credits" grid
 *  - "From the set" amber-tinted callout
 *
 * Sections from the design intentionally NOT rendered yet, with the
 * reason for each:
 *  - Save to collection      — requires accounts (M5).
 *  - Where to buy            — requires a price feed (not in M1).
 *  - {ink}/{lore}/{exert}    — inline icon replacement in rules text
 *                              (polish; NOT a hover popover — see below).
 *
 * Cut from scope by the project owner (not deferred — will not be built):
 *  - "Mentioned in news"     — reverse news→card index.
 *  - Reusing the card-preview popover on rules-text tokens.
 *
 * Available variables documented in core's node.html.twig, plus
 * card_prev / card_next / card_position / card_set_total injected by
 * inkfolk_preprocess_node().
 */
#}
{% set version = node.field_version.value %}
{% set version_suffix = version ? ' — ' ~ version : '' %}
{% set base_name = version ? node.label|replace({(version_suffix): ''}) : node.label %}
{% set set_node = node.field_set.entity %}
{# Ink slug + rarity slug stay English (CSS swatch classes); the displayed
   labels (card_ink_chips, rarity) are in the card's language. #}
{% set ink_slug = card_ink_chips ? card_ink_chips.0.slug : '' %}
{% set rarity = content.field_rarity|render|striptags|trim %}
{% set rarity_slug = node.field_rarity.value|replace({'_': '-'}) %}

{% set stats = [
  { key: 'cost',      label: 'Cost'|t,      value: node.field_cost.value,      show: node.field_cost.value is not empty },
  { key: 'strength',  label: 'Strength'|t,  value: node.field_strength.value,  show: node.field_strength.value is not empty },
  { key: 'willpower', label: 'Willpower'|t, value: node.field_willpower.value, show: node.field_willpower.value is not empty },
  { key: 'lore',      label: 'Lore'|t,      value: node.field_lore.value,      show: node.field_lore.value is not empty },
] %}

<nav class="if-card-breadcrumb" aria-label="{{ 'Card breadcrumb'|t }}">
  <div class="if-card-breadcrumb__inner">
    <ol class="if-card-breadcrumb__trail">
      <li><a href="/cards">{{ 'Cards'|t }}</a></li>
      {% if set_node %}
        <li><a href="{{ path('entity.node.canonical', {'node': set_node.id}) }}">{{ card_set_label }}</a></li>
      {% endif %}
      <li>{{ node.label }}</li>
    </ol>
    <div class="if-card-breadcrumb__pager">
      {% if card_prev %}
        <a class="if-btn" href="{{ path('entity.node.canonical', {'node': card_prev.id}) }}">‹ {{ 'Prev'|t }}</a>
      {% else %}
        <span class="if-btn if-btn--disabled">‹ {{ 'Prev'|t }}</span>
      {% endif %}
      {% if card_next %}
        <a class="if-btn" href="{{ path('entity.node.canonical', {'node': card_next.id}) }}">{{ 'Next'|t }} ›</a>
      {% else %}
        <span class="if-btn if-btn--disabled">{{ 'Next'|t }} ›</span>
      {% endif %}
    </div>
  </div>
</nav>

<article{{ attributes.addClass(['if-card-detail', ink_slug ? 'if-card-detail--ink-' ~ ink_slug]) }}>

  <aside class="if-card-detail__art">
    <div class="if-lcard if-cardframe--subtle">
      <div class="if-card-image">{{ content.field_card_art }}</div>
      {# Overlay button — keeps the image markup valid (no block content
         inside a <button>) while giving keyboard + screen-reader users
         a focusable trigger that the JS lightbox can hook. #}
      <button type="button" class="if-card-detail__zoom" aria-label="{{ 'View larger image'|t }}"></button>
    </div>
  </aside>

  <div class="if-card-detail__info">

    <div class="if-card-detail__chips">
      {% if card_ink_chips %}
        <span class="if-chip if-chip--ink">
          {% if card_ink_chips|length > 1 %}
            <span class="if-swatch if-swatch--split"
                  style="--ink-a: var(--ink-{{ card_ink_chips.0.slug }}); --ink-b: var(--ink-{{ card_ink_chips.1.slug }});"
                  aria-hidden="true"></span>
          {% else %}
            <span class="if-swatch if-swatch--{{ ink_slug }}" aria-hidden="true"></span>
          {% endif %}
          {{ card_ink_chips|map(c => c.label)|join(' + ') }}
        </span>
      {% endif %}
      {% for type_label in card_type_labels %}
        <span class="if-chip">{{ type_label }}</span>
      {% endfor %}
      {% if rarity %}
        <span class="if-chip if-chip--rarity">
          <span class="if-swatch if-swatch--{{ rarity_slug }}" aria-hidden="true"></span>
          {{ rarity }}
        </span>
      {% endif %}
      {% for cls_label in card_classification_labels %}
        <span class="if-chip if-chip--ghost">{{ cls_label }}</span>
      {% endfor %}
    </div>

    <h1 class="if-card-detail__title serif">{{ base_name }}</h1>
    {% if version %}
      <h2 class="if-card-detail__subtitle serif">{{ version }}</h2>
    {% endif %}

    <div class="if-card-detail__stats">
      {% for stat in stats %}
        {% if stat.show %}
          <div class="if-stat if-stat--{{ stat.key }}">
            <span class="if-stat__icon" aria-hidden="true">
              {% if stat.key == 'cost' %}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                  <path d="M12 1.5C10 5 5 10.5 5 15a7 7 0 0 0 14 0c0-4.5-5-10-7-13.5Z"
                        fill="currentColor"/>
                </svg>
              {% elseif stat.key == 'strength' %}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                  <path d="M4 4l9 9M4 20l6-6M20 4l-7 7M20 20l-6-6"/>
                  <circle cx="13" cy="11" r="2.4" fill="currentColor" stroke="none"/>
                </svg>
              {% elseif stat.key == 'willpower' %}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
                  <path d="M12 3 4 6v6c0 4.5 3.5 8 8 9 4.5-1 8-4.5 8-9V6l-8-3Z"/>
                </svg>
              {% elseif stat.key == 'lore' %}
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                  <path d="M12 3 15 9 21 12 15 15 12 21 9 15 3 12 9 9Z"
                        fill="currentColor"/>
                </svg>
              {% endif %}
            </span>
            <span class="if-stat__value mono">{{ stat.value }}</span>
            <span class="if-stat__label">{{ stat.label }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if node.field_text.value or node.field_flavor_text.value %}
      <section class="if-card-detail__rules">
        <div class="if-card-detail__eyebrow">{{ 'Rules text'|t }}</div>
        <div class="if-card-detail__rules-body serif">
          {% if node.field_text.value %}{{ content.field_text }}{% endif %}
          {% if node.field_flavor_text.value %}
            <div class="if-card-detail__flavor">{{ content.field_flavor_text }}</div>
          {% endif %}
        </div>
      </section>
    {% endif %}

    <section class="if-card-detail__meta-grid">
      <div class="if-card-detail__meta-box">
        <div class="if-card-detail__eyebrow">{{ 'Printing details'|t }}</div>
        <dl class="if-card-detail__dl">
          {% if set_node %}
            <div>
              <dt>{{ 'Set'|t }}</dt>
              <dd><a href="{{ path('entity.node.canonical', {'node': set_node.id}) }}">{{ card_set_label }}</a></dd>
            </div>
          {% endif %}
          {% if node.field_collector_number.value %}
            <div>
              <dt>{{ 'Collector №'|t }}</dt>
              <dd>{{ node.field_collector_number.value }}{% if set_node and set_node.field_card_count.value %} / {{ set_node.field_card_count.value }}{% endif %}</dd>
            </div>
          {% endif %}
          {% if node.field_released_at.value %}
            <div>
              <dt>{{ 'Released'|t }}</dt>
              <dd>{{ node.field_released_at.0.value|date('M j, Y') }}</dd>
            </div>
          {% endif %}
          <div>
            <dt>{{ 'Languages'|t }}</dt>
            <dd class="if-card-langs">
              <span class="if-card-langs__current">{{ node.langcode.value|upper }}</span>
              {% for lang in card_languages %}
                <span class="if-card-langs__sep" aria-hidden="true">·</span>
                <a class="if-card-langs__other" href="{{ lang.url }}" hreflang="{{ lang.langcode }}" title="{{ lang.name }}">{{ lang.label }}</a>
              {% endfor %}
            </dd>
          </div>
        </dl>
      </div>
      <div class="if-card-detail__meta-box">
        <div class="if-card-detail__eyebrow">{{ 'Credits'|t }}</div>
        <dl class="if-card-detail__dl">
          {% if node.field_illustrators.value %}
            <div>
              <dt>{{ 'Illustrator'|t }}</dt>
              <dd>{{ node.field_illustrators.value }}</dd>
            </div>
          {% endif %}
          <div>
            <dt>{{ 'Inkable'|t }}</dt>
            <dd>{{ node.field_inkable.value ? 'Yes'|t : 'No'|t }}</dd>
          </div>
          {% if node.field_legal_core.value is not empty %}
            <div>
              <dt>{{ 'Format'|t }}</dt>
              <dd>{{ node.field_legal_core.value|capitalize }}</dd>
            </div>
          {% endif %}
        </dl>
      </div>
    </section>

    {% if card_printings is not empty %}
      <section class="if-card-detail__printings">
        <div class="if-card-detail__eyebrow">{{ 'Other printings'|t }}</div>
        <div class="if-printings-strip if-scroll">
          {% for p in card_printings %}
            <a class="if-printing{{ p.is_enchanted ? ' if-printing--enchanted' }}" href="{{ p.url }}">
              <div class="if-printing__frame if-printing__frame--{{ p.ink_slug }}">
                <div class="if-printing__art">{{ p.image }}</div>
              </div>
              {% if p.rarity %}<div class="if-printing__rarity">{{ p.rarity }}</div>{% endif %}
              {% if p.number %}<div class="if-printing__num mono">{{ p.number }}</div>{% endif %}
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if set_node %}
      <section class="if-card-detail__from-set">
        <a href="{{ path('entity.node.canonical', {'node': set_node.id}) }}" class="if-from-set">
          {% set _set_code = set_node.field_set_code.value %}
          <div class="if-from-set__numeral serif" data-len="{{ _set_code|length }}">{{ _set_code }}</div>
          <div class="if-from-set__body">
            <div class="if-from-set__eyebrow">{{ 'From the set'|t }}</div>
            <h3 class="if-from-set__title serif">{{ card_set_label }}</h3>
            <div class="if-from-set__meta">
              {% if set_node.field_card_count.value %}{{ set_node.field_card_count.value }} {{ 'cards'|t }} · {% endif %}
              {% if set_node.field_released_at.value %}{{ set_node.field_released_at.0.value|date('M Y') }}{% endif %}
            </div>
          </div>
          <span class="if-btn if-btn--primary">{{ 'Browse set'|t }} →</span>
        </a>
      </section>
    {% endif %}

  </div>

</article>
