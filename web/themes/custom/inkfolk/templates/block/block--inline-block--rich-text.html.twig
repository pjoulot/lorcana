{#
/**
 * @file
 * Inkfolk editorial "Rich text" inline block — optional eyebrow + body, with a
 * style treatment (plain / card / bordered / white / warning) and an optional
 * leading icon. Reusable anywhere.
 * Variables: inkfolk_eyebrow, inkfolk_style, inkfolk_icon, content.body.
 */
#}
{% set style = inkfolk_style|default('plain') %}
{% set classes = ['if-rt', 'if-rt--' ~ style] %}
{% if inkfolk_icon %}{% set classes = classes|merge(['if-rt--has-icon']) %}{% endif %}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% if inkfolk_icon == 'badge' %}
    <div class="if-rt__icon" aria-hidden="true">
      <svg viewBox="-2015 -2000 4030 4030" width="50" height="50" focusable="false">
        <path fill="var(--ink-ruby)" d="m-90 2030 45-863a95 95 0 0 0-111-98l-859 151 116-320a65 65 0 0 0-20-73l-941-762 212-99a65 65 0 0 0 34-79l-186-572 542 115a65 65 0 0 0 73-38l105-247 423 454a65 65 0 0 0 111-57l-204-1052 327 189a65 65 0 0 0 91-27l332-652 332 652a65 65 0 0 0 91 27l327-189-204 1052a65 65 0 0 0 111 57l423-454 105 247a65 65 0 0 0 73 38l542-115-186 572a65 65 0 0 0 34 79l212 99-941 762a65 65 0 0 0-20 73l116 320-859-151a95 95 0 0 0-111 98l45 863z"/>
      </svg>
    </div>
  {% endif %}
  <div class="if-rt__main">
    {% if inkfolk_eyebrow %}
      <div class="if-rt__eyebrow">{{ inkfolk_eyebrow }}</div>
    {% endif %}
    {% if content.body|render|trim %}
      <div class="if-rt__body">{{ content.body }}</div>
    {% endif %}
  </div>
</div>
