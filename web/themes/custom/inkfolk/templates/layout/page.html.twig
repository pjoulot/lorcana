{#
/**
 * @file
 * Inkfolk page layout — sticky topnav + main + design footer.
 *
 * Primary navigation comes from the Main menu (`topnav_nav` region);
 * footer link columns come from the Footer menu (`footer_menu`
 * region, rendered as a 2-level hierarchy where depth-1 items become
 * column headings). Both are wired via region template + menu
 * template overrides so the Drupal menu block renders the design's
 * exact markup.
 *
 * Search / language / "Start a draft" stay hardcoded — they're not
 * navigation, and there's no editor benefit to making them blocks.
 *
 * Variables documented in the stock Drupal page.html.twig.
 */
#}
<div class="if-shell">

  <header class="if-topnav" role="banner">
    <div class="if-topnav__inner">
      <div class="if-topnav__left">
        <a href="{{ path('<front>') }}" class="if-wordmark" aria-label="{{ 'Inkfolk — home'|t }}">
          <svg width="22" height="22" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
            <path d="M5 14c0-3 2-5 5-5h8c3 0 5 2 5 5v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-6Z" fill="var(--accent)"/>
            <ellipse cx="14" cy="9" rx="6" ry="1.4" fill="var(--accent)" opacity=".5"/>
            <path d="M15 9c1-3 4-6 7-7-1 3-2 5-3 6" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" fill="none"/>
          </svg>
          <span class="if-wordmark__text serif">inkfolk</span>
        </a>
        {{ page.topnav_nav }}
      </div>

      <form class="if-topnav__search" role="search" action="/cards" method="get">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/>
          <path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <input name="search" type="search"
               placeholder="{{ 'Search cards, sets, abilities…'|t }}"
               aria-label="{{ 'Search'|t }}"/>
        <span class="if-kbd" aria-hidden="true">⌘ K</span>
      </form>

      <div class="if-topnav__actions">
        <button type="button" class="if-btn" aria-label="{{ 'Language'|t }}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
            <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          EN
        </button>
        <a href="/draft" class="if-btn if-btn--primary">{{ 'Start a draft'|t }}</a>
      </div>
    </div>
  </header>

  {{ page.breadcrumb }}
  {{ page.highlighted }}
  {{ page.help }}

  <main role="main" class="if-main{% if page.sidebar_first %} if-main--with-sidebar{% endif %}">
    {% if page.sidebar_first %}
      <aside class="if-sidebar" aria-label="{{ 'Filters'|t }}">
        {{ page.sidebar_first }}
      </aside>
    {% endif %}
    <div id="main-content" tabindex="-1" class="if-main__content">
      {% if page.content_top %}
        <div class="if-main__content-top">{{ page.content_top }}</div>
      {% endif %}
      {{ page.content }}
    </div>
  </main>

  <footer class="if-footer" role="contentinfo">
    <div class="if-footer__inner">
      <div class="if-footer__cols">
        <div class="if-footer__brand">
          <a href="{{ path('<front>') }}" class="if-wordmark" aria-label="{{ 'Inkfolk — home'|t }}">
            <svg width="20" height="20" viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
              <path d="M5 14c0-3 2-5 5-5h8c3 0 5 2 5 5v6a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3v-6Z" fill="var(--accent)"/>
              <ellipse cx="14" cy="9" rx="6" ry="1.4" fill="var(--accent)" opacity=".5"/>
              <path d="M15 9c1-3 4-6 7-7-1 3-2 5-3 6" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" fill="none"/>
            </svg>
            <span class="if-wordmark__text serif">inkfolk</span>
          </a>
          <p>{{ 'A fan project by hobbyists. No ads, no analytics, no paywalls — ever.'|t }}</p>
        </div>
        {{ page.footer_menu }}
      </div>
      <div class="if-footer__bottom">
        <p class="if-footer__disclaimer">
          {{ 'This site is an unofficial, non-commercial fan project and is not published, endorsed, or specifically approved by Disney or Ravensburger. Card images used under Ravensburger\'s Community Code Policy.'|t }}
        </p>
        <div class="if-footer__meta">
          <span>EN · FR</span>
          <span>v0.3 · {{ 'now'|date('Y') }}</span>
        </div>
      </div>
    </div>
  </footer>

</div>
