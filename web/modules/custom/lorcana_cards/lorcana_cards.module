        'title' => '',
        'see_all_label' => '',
        'see_all_url' => '',
        'articles' => [],
      ],
    ],
    'inkfolk_card_preview' => [
      'variables' => [
        'name' => '',
        'url' => '',
        'image' => NULL,
        'ink' => '',
        'ink_label' => '',
        'types' => [],
        'rarity' => '',
        'set_label' => '',
        'stats' => [],
      ],
    ],
    'inkfolk_toc' => [
