<?php

/**
 * @file
 * Module file for the Lorcana Cards module.
 */

declare(strict_types=1);

use Drupal\Core\Language\LanguageInterface;
use Drupal\search_api\Query\QueryInterface;

/**
 * Implements hook_search_api_query_alter().
 *
 * On the cards index: restrict results to the visitor's content language (each
 * language has its own card nodes, so the encyclopedia defaults to one), then
 * apply the encyclopedia's Scryfall-like search syntax.
 */
function lorcana_cards_search_api_query_alter(QueryInterface $query): void {
  if ($query->getIndex()->id() !== 'cards') {
    return;
  }
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  $query->addCondition('langcode', $langcode);
  \Drupal::service('lorcana_cards.search_syntax')->applyTo($query);
}

/**
 * Implements hook_theme().
 */
function lorcana_cards_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'inkfolk_hero' => [
      'variables' => [
        'title' => '',
        'title_accent' => '',
        'copy' => '',
        'search_placeholder' => '',
        'try_examples' => [],
        'latest_set' => NULL,
        'latest_set_card_count' => 0,
        'spread_cards' => [],
