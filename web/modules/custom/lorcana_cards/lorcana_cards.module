    'inkfolk_popular' => [
      'variables' => [
        'eyebrow' => '',
        'title' => '',
        'see_all_label' => '',
        'see_all_url' => '',
        'cards' => [],
      ],
    ],
    'inkfolk_sets' => [
      'variables' => [
        'eyebrow' => '',
        'title' => '',
        'see_all_label' => '',
        'see_all_url' => '',
        'sets' => [],
      ],
    ],
    'inkfolk_recent_news' => [
      'variables' => [
